.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 90;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.modal-panel {
  background: #09090b;
  border-top: 2rpx solid rgba(39, 39, 42, 0.85);
  border-top-left-radius: 44rpx;
  border-top-right-radius: 44rpx;
  padding: 36rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.modal-close {
  font-size: 24rpx;
  color: #a1a1aa;
  padding: 8rpx 12rpx;
}
