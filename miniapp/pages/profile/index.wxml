<view class="page-shell">
  <view class="page-header">
    <view class="page-title" style="margin-bottom: 32rpx;">我的</view>

    <view class="profile-hero">
      <view class="avatar-box">
        <image class="user-avatar" src="{{user.avatar}}" mode="aspectFill" />
        <view class="verify-dot">
          <ui-icon name="check" size="22" color="#000000" />
        </view>
      </view>

      <view class="user-meta">
        <view class="user-name">{{user.name}}</view>
        <view class="user-id">ID: {{user.id}}</view>
        <view class="user-phone">{{user.phone}}</view>
        <view wx:if="{{user.bio}}" class="user-bio">{{user.bio}}</view>
        <view class="role-tag">{{user.role === 'user' ? '普通用户' : '陪玩身份'}}</view>
      </view>

      <view class="gear-btn" bindtap="onOpenEdit">
        <ui-icon name="settings" size="34" color="#a1a1aa" />
      </view>
    </view>
  </view>

  <view class="page-body">
    <view class="wallet-grid">
      <view class="card wallet-card" bindtap="onOpenWallet">
        <view class="w-head" style="display:flex;align-items:center;gap:8rpx;">
          <ui-icon name="wallet" size="26" color="#71717a" />
          <text>钱包余额</text>
        </view>
        <view class="w-val">
          <text class="w-unit">¥</text>
          <text>{{balanceFixed}}</text>
        </view>
      </view>

      <view class="card wallet-card">
        <view class="w-head" style="display:flex;align-items:center;gap:8rpx;">
          <ui-icon name="ticket" size="26" color="#71717a" />
          <text>优惠券</text>
        </view>
        <view class="w-val">
          <text>{{user.coupons}}</text>
          <text class="w-unit"> 张</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <view>
          <view class="loc-head" style="display:flex;align-items:center;gap:8rpx;">
            <ui-icon name="map-pin" size="26" color="#71717a" />
            <text>当前位置</text>
          </view>
          <view class="loc-main">{{user.locationCity || '未开启定位'}}</view>
          <view class="loc-sub">{{user.locationLabel}}</view>
        </view>
        <view class="loc-btn {{user.locationStatus === 'granted' ? 'loc-btn-on' : ''}}" bindtap="onRequestLocation">
          <ui-icon name="locate-fixed" size="34" color="{{user.locationStatus === 'granted' ? '#10b981' : '#d4d4d8'}}" />
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row-between">
        <view>
          <view class="loc-head" style="display:flex;align-items:center;gap:8rpx;">
            <ui-icon name="star-fill" size="26" color="#eab308" />
            <text>{{reviewTitle}}</text>
          </view>
          <view class="loc-sub">{{reviewHint}}</view>
        </view>
        <view style="text-align:right;">
          <view class="rev-avg">{{reviewSummary.count > 0 ? reviewSummary.average : '--'}}</view>
          <view class="loc-sub">{{reviewSummary.count}} 条 · 好评率 {{reviewSummary.positiveRate}}%</view>
        </view>
      </view>

      <view wx:if="{{reviewSummary.topTags.length}}" class="top-tags-row">
        <text wx:for="{{reviewSummary.topTags}}" wx:key="tag" class="pill pill-active">{{item.tag}}</text>
      </view>

      <view wx:if="{{receivedReviews.length === 0}}" class="card-inner empty-rep">
        完成订单后，这里会沉淀对你本人的服务口碑。
      </view>
      <view wx:else class="rep-list">
        <view wx:for="{{receivedReviews}}" wx:key="orderId" class="card-inner rep-item">
          <view class="row-between">
            <text class="rep-author">{{item.displayAuthorName}}</text>
            <view class="rep-stars" style="display:flex;align-items:center;gap:4rpx;">
              <ui-icon wx:for="{{item.stars}}" wx:key="*this" name="star-fill" size="22" color="#eab308" />
            </view>
          </view>
          <view wx:if="{{item.tags && item.tags.length}}" class="rep-tags">
            <text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text>
          </view>
          <view class="rep-content">{{item.content}}</view>
        </view>
      </view>
    </view>

    <view class="card menu-card">
      <view class="menu-item" bindtap="onOpenRole">
        <view class="menu-left">
          <view class="menu-icon icon-green">
            <ui-icon name="shield-check" size="34" color="#34d399" />
          </view>
          <view>
            <view class="menu-title">切换身份（演示）</view>
            <view class="menu-sub">当前：{{user.role === 'user' ? '用户端' : '陪玩端'}}</view>
          </view>
        </view>
        <ui-icon name="chevron-right" size="32" color="#52525b" />
      </view>

      <view class="menu-item" bindtap="onOpenEdit">
        <view class="menu-left">
          <view class="menu-icon">
            <ui-icon name="pencil" size="32" color="#a1a1aa" />
          </view>
          <view>
            <view class="menu-title">编辑资料</view>
            <view class="menu-sub">昵称、简介、性别偏好</view>
          </view>
        </view>
        <ui-icon name="chevron-right" size="32" color="#52525b" />
      </view>

      <view class="menu-item" bindtap="onOpenApply">
        <view class="menu-left">
          <view class="menu-icon icon-gold">
            <ui-icon name="star" size="34" color="#facc15" />
          </view>
          <view>
            <view class="menu-title">成为陪玩 / 达人认证</view>
            <view class="menu-sub">实名入驻、设定时薪与常驻球房</view>
          </view>
        </view>
        <ui-icon name="chevron-right" size="32" color="#52525b" />
      </view>

      <view class="menu-item" data-tip="已支持微信 jscode2session 静默登录与手机号授权" bindtap="onMenuTip">
        <view class="menu-left">
          <view class="menu-icon icon-green">
            <ui-icon name="smartphone" size="34" color="#34d399" />
          </view>
          <view>
            <view class="menu-title">账号安全</view>
            <view class="menu-sub">微信绑定与手机号实名保护</view>
          </view>
        </view>
        <text class="menu-sub">{{user.lastLoginAt ? '最近已登录' : '已保护'}}</text>
      </view>

      <view class="menu-item" data-tip="客服热线：400-800-8899（工作日 09:00-22:00）" bindtap="onMenuTip">
        <view class="menu-left">
          <view class="menu-icon">
            <ui-icon name="help-circle" size="34" color="#a1a1aa" />
          </view>
          <view class="menu-title">帮助中心与客服</view>
        </view>
        <ui-icon name="chevron-right" size="32" color="#52525b" />
      </view>

      <view class="menu-item menu-item-last" bindtap="onOpenPrivacyDoc">
        <view class="menu-left">
          <view class="menu-icon">
            <ui-icon name="settings" size="34" color="#a1a1aa" />
          </view>
          <view>
            <view class="menu-title">隐私保护指引与服务协议</view>
            <view class="menu-sub">v1.2.0 商业版 · 本地 SQLite 已连接</view>
          </view>
        </view>
        <ui-icon name="chevron-right" size="32" color="#52525b" />
      </view>
    </view>

    <view class="bottom-btn-grid">
      <view class="btn-secondary" bindtap="onLogout">退出登录</view>
      <view class="btn-reset" bindtap="onResetData">重置演示数据</view>
    </view>
  </view>

  <bottom-nav active="profile" />

  <!-- 钱包 Modal -->
  <modal-sheet open="{{openWallet}}" title="钱包" bind:close="onCloseWallet">
    <view class="modal-stack">
      <view class="row-between">
        <text class="text-muted">当前余额</text>
        <text class="wallet-modal-bal">¥{{balanceFixed}}</text>
      </view>
      <view class="charge-grid">
        <view class="btn-secondary" data-amount="50" bindtap="onCharge">充值 ¥50</view>
        <view class="btn-secondary" data-amount="100" bindtap="onCharge">充值 ¥100</view>
        <view class="btn-secondary" data-amount="300" bindtap="onCharge">充值 ¥300</view>
      </view>
      <view class="loc-sub">支持微信支付（JSAPI）充值与订单原路退款。</view>
    </view>
  </modal-sheet>

  <!-- 编辑资料 Modal -->
  <modal-sheet open="{{openEdit}}" title="编辑资料" bind:close="onCloseEdit">
    <view class="modal-stack">
      <view class="row-between card-inner" style="padding: 20rpx 24rpx;">
        <view class="row-center" style="gap: 16rpx;">
          <image
            src="{{profileAvatar || user.avatar}}"
            mode="aspectFill"
            style="width: 84rpx; height: 84rpx; border-radius: 999rpx; border: 2rpx solid #10b981;"
          />
          <view>
            <view style="font-size: 26rpx; color: #f4f4f5; font-weight: 600;">头像设置</view>
            <view style="font-size: 22rpx; color: #71717a;">支持一键获取微信头像</view>
          </view>
        </view>
        <button
          open-type="chooseAvatar"
          bindchooseavatar="onChooseWxAvatar"
          class="btn-sm-outline"
          style="margin: 0; line-height: 1.5;"
        >使用微信头像</button>
      </view>
      <view>
        <view class="field-label">昵称（支持微信昵称自动填入）</view>
        <input
          type="nickname"
          class="input-box"
          value="{{profileName}}"
          data-field="profileName"
          bindinput="onInputField"
          bindchange="onInputField"
        />
      </view>
      <view>
        <view class="field-label">自我介绍</view>
        <textarea
          class="textarea-box"
          value="{{profileBio}}"
          data-field="profileBio"
          bindinput="onInputField"
        />
      </view>
      <view>
        <view class="field-label">性别</view>
        <view class="charge-grid">
          <view
            class="pill gender-btn {{profileGender === 'male' ? 'pill-active' : ''}}"
            data-gender="male"
            bindtap="onSelectGender"
          >男</view>
          <view
            class="pill gender-btn {{profileGender === 'female' ? 'pill-active' : ''}}"
            data-gender="female"
            bindtap="onSelectGender"
          >女</view>
          <view
            class="pill gender-btn {{profileGender === 'other' ? 'pill-active' : ''}}"
            data-gender="other"
            bindtap="onSelectGender"
          >保密</view>
        </view>
      </view>
      <view wx:if="{{profileHint}}" class="hint-green">{{profileHint}}</view>
      <view class="btn-primary" bindtap="onSaveProfile">保存资料</view>
    </view>
  </modal-sheet>

  <!-- 成为陪玩 / 达人认证 Modal -->
  <modal-sheet open="{{openApply}}" title="成为陪玩 · 达人认证入驻" bind:close="onCloseApply">
    <view class="modal-stack">
      <view>
        <view class="field-label">达人称呼 / 助教艺名</view>
        <input
          class="input-box"
          value="{{applyName}}"
          data-field="applyName"
          bindinput="onInputField"
          placeholder="例如：阿泽 (八球助教)"
          placeholder-style="color:#52525b;"
        />
      </view>
      <view class="charge-grid" style="grid-template-columns: repeat(2, 1fr);">
        <view>
          <view class="field-label">专业段位 / 头衔</view>
          <input
            class="input-box"
            value="{{applyLevel}}"
            data-field="applyLevel"
            bindinput="onInputField"
            placeholder="如：中式八球七档"
            placeholder-style="color:#52525b;"
          />
        </view>
        <view>
          <view class="field-label">服务时薪 (¥/小时)</view>
          <input
            type="number"
            class="input-box"
            value="{{applyRate}}"
            data-field="applyRate"
            bindinput="onInputField"
            placeholder="168"
            placeholder-style="color:#52525b;"
          />
        </view>
      </view>
      <view>
        <view class="field-label">常驻合作球房</view>
        <input
          class="input-box"
          value="{{applyVenue}}"
          data-field="applyVenue"
          bindinput="onInputField"
          placeholder="CueMate 台球俱乐部（望京店）"
          placeholder-style="color:#52525b;"
        />
      </view>
      <view>
        <view class="field-label">教学与陪练特长介绍</view>
        <textarea
          class="textarea-box"
          value="{{applyBio}}"
          data-field="applyBio"
          bindinput="onInputField"
          placeholder="介绍你的擅长球类、教学风格或实战陪练特点..."
          placeholder-style="color:#52525b;"
        />
      </view>
      <view class="btn-primary" bindtap="onSubmitApply">提交认证并开启接单台</view>
    </view>
  </modal-sheet>

  <!-- 隐私与合规说明 Modal -->
  <modal-sheet open="{{openPrivacyDoc}}" title="{{privacyDoc.title}}" bind:close="onClosePrivacyDoc">
    <view class="modal-stack">
      <text style="font-size: 25rpx; color: #d4d4d8; line-height: 1.8; white-space: pre-wrap;">{{privacyDoc.content}}</text>
      <view class="btn-primary" bindtap="onClosePrivacyDoc">我知道了</view>
    </view>
  </modal-sheet>

  <!-- 选择身份 Modal -->
  <modal-sheet open="{{openRole}}" title="选择身份" bind:close="onCloseRole">
    <view class="modal-stack">
      <view
        class="role-card {{user.role === 'user' ? 'role-card-active' : ''}}"
        bindtap="onSwitchToUser"
      >
        <view class="role-card-title">用户端</view>
        <view class="loc-sub">浏览陪玩、预约下单、支付核销</view>
      </view>

      <view class="loc-sub">陪玩端（选择“我是谁”）</view>
      <view class="role-comp-list">
        <view
          wx:for="{{companions}}"
          wx:key="id"
          class="role-card role-comp-row {{user.role === 'companion' && user.companionId === item.id ? 'role-card-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSwitchToCompanion"
        >
          <image class="role-comp-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view>
            <view class="role-card-title">{{item.name}}</view>
            <view class="loc-sub">{{item.level}} · ¥{{item.hourlyRate}}/h</view>
          </view>
        </view>
      </view>
    </view>
  </modal-sheet>
</view>
