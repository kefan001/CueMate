.profile-hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-box {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  flex-shrink: 0;
}

.user-avatar {
  width: 148rpx;
  height: 148rpx;
  border-radius: 999rpx;
  border: 4rpx solid #27272a;
}

.verify-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background-color: #10b981;
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #09090b;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.user-id {
  font-size: 22rpx;
  color: #71717a;
  font-family: monospace;
  margin-top: 4rpx;
}

.user-phone,
.user-bio {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.role-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background-color: #18181b;
  border: 2rpx solid #27272a;
  font-size: 22rpx;
  color: #a1a1aa;
}

.gear-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background-color: #18181b;
  border: 2rpx solid #27272a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #a1a1aa;
}

.wallet-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.wallet-card {
  padding: 28rpx;
}

.w-head {
  font-size: 26rpx;
  color: #a1a1aa;
  margin-bottom: 16rpx;
}

.w-val {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.w-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: #71717a;
}

.loc-head {
  font-size: 28rpx;
  font-weight: 500;
  color: #d4d4d8;
}

.loc-main {
  font-size: 28rpx;
  color: #ffffff;
  margin-top: 12rpx;
}

.loc-sub {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.loc-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
  border: 2rpx solid #27272a;
  background-color: #09090b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #d4d4d8;
}

.loc-btn-on {
  color: #34d399;
}

.rev-avg {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
}

.top-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.empty-rep {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #71717a;
  padding: 28rpx;
}

.rep-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rep-author {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
}

.rep-stars {
  color: #facc15;
  font-size: 24rpx;
}

.rep-tags {
  margin-top: 12rpx;
}

.rep-content {
  font-size: 24rpx;
  color: #a1a1aa;
  margin-top: 10rpx;
}

.menu-card {
  padding: 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid rgba(39, 39, 42, 0.65);
}

.menu-item-last {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background-color: #27272a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.icon-green {
  background-color: rgba(16, 185, 129, 0.14);
  color: #34d399;
}

.icon-gold {
  background-color: rgba(250, 204, 21, 0.14);
  color: #facc15;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #e4e4e7;
}

.menu-sub {
  font-size: 20rpx;
  color: #71717a;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #52525b;
}

.bottom-btn-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 36rpx;
}

.btn-reset {
  border: 2rpx solid rgba(39, 39, 42, 0.8);
  color: #f87171;
  font-size: 28rpx;
  font-weight: 500;
  padding: 24rpx 36rpx;
  border-radius: 28rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.wallet-modal-bal {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.charge-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.field-label {
  font-size: 26rpx;
  color: #a1a1aa;
  margin-bottom: 12rpx;
}

.gender-btn {
  justify-content: center;
  padding: 22rpx 0;
}

.hint-green {
  font-size: 26rpx;
  color: #6ee7b7;
}

.role-card {
  padding: 28rpx;
  border-radius: 28rpx;
  border: 2rpx solid #27272a;
  background-color: #18181b;
}

.role-card-active {
  background-color: rgba(16, 185, 129, 0.16);
  border-color: rgba(16, 185, 129, 0.45);
}

.role-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.role-comp-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-comp-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.role-comp-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
}
