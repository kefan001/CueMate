<view class="page-shell">
  <view class="page-header">
    <view class="row-between">
      <view>
        <view class="page-title">接单台</view>
        <view class="page-subtitle">{{me ? me.name + ' · ' + me.level : '陪玩端（演示）'}}</view>
        <view
          wx:if="{{me}}"
          class="pill {{me.onlineStatus === 'resting' ? '' : 'pill-active'}}"
          style="display:inline-flex;align-items:center;gap:8rpx;margin-top:14rpx;"
          bindtap="onToggleOnline"
        >
          <ui-icon name="check-circle" size="22" color="{{me.onlineStatus === 'resting' ? '#a1a1aa' : '#34d399'}}" />
          <text>{{me.onlineStatus === 'resting' ? '休息中（点击恢复接单）' : '在线接单中（点击暂停）'}}</text>
        </view>
      </view>
      <view class="today-box">
        <view class="today-label">今日待服务</view>
        <view class="today-val">{{todayCount}}</view>
      </view>
    </view>
  </view>

  <view class="page-body">
    <view class="card">
      <view class="row-between">
        <view>
          <view class="row-center" style="gap: 8rpx; font-size: 24rpx; color: #a1a1aa;">
            <ui-icon name="wallet" size="26" color="#10b981" />
            <text>可提现服务收益（平台分账后）</text>
          </view>
          <view style="font-size: 48rpx; font-weight: 700; color: #ffffff; margin-top: 10rpx;">
            ¥{{withdrawableAmount}}
          </view>
          <view style="font-size: 22rpx; color: #71717a; margin-top: 6rpx;">
            累计完单总额 ¥{{totalEarned}} · 已提现 ¥{{withdrawnTotal}}
          </view>
        </view>
        <view class="btn-sm-primary" bindtap="onWithdraw">提现到零钱</view>
      </view>
    </view>

    <view class="stat-grid">
      <view class="card stat-card" bindtap="goCompanionOrders">
        <view class="stat-head" style="display:flex;align-items:center;gap:8rpx;">
          <ui-icon name="clock" size="24" color="#71717a" />
          <text>待服务</text>
        </view>
        <view class="stat-num">{{incomingCount}}</view>
      </view>
      <view class="card stat-card" bindtap="goCompanionOrders">
        <view class="stat-head" style="display:flex;align-items:center;gap:8rpx;">
          <ui-icon name="trophy" size="24" color="#71717a" />
          <text>服务中</text>
        </view>
        <view class="stat-num">{{activeCount}}</view>
      </view>
      <view class="card stat-card" bindtap="goCompanionOrders">
        <view class="stat-head" style="display:flex;align-items:center;gap:8rpx;">
          <ui-icon name="check-circle" size="24" color="#71717a" />
          <text>已完成</text>
        </view>
        <view class="stat-num">{{completedCount}}</view>
      </view>
    </view>

    <view class="row-between list-head">
      <text class="list-title">待服务订单</text>
      <text class="list-sub" bindtap="goCompanionOrders">查看全部接单 ›</text>
    </view>

    <view wx:if="{{incomingOrders.length === 0}}" class="empty-box">
      暂无新订单
    </view>

    <view wx:for="{{incomingOrders}}" wx:key="id" class="card">
      <view class="row-between" style="margin-bottom:14rpx;">
        <text class="order-id">{{item.id}}</text>
        <view class="status-badge tone-{{item.statusMeta.tone}}">{{item.statusMeta.label}}</view>
      </view>

      <view class="cust-name">{{item.customerName || '用户'}}</view>
      <view class="cust-time">{{item.timeText}}</view>

      <view class="row-between" style="margin-top:28rpx;">
        <view class="cust-price">¥{{item.totalPrice}}</view>
        <view class="cust-actions">
          <view class="chat-btn" data-id="{{item.id}}" bindtap="openChat">
            <ui-icon name="message-circle" size="30" color="#d4d4d8" />
          </view>
          <view class="btn-sm-primary" data-id="{{item.id}}" bindtap="startService">开始服务</view>
        </view>
      </view>
    </view>
  </view>

  <bottom-nav active="companion-dashboard" />
</view>
