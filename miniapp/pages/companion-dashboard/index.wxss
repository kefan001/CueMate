.today-box {
  text-align: right;
}

.today-label {
  font-size: 22rpx;
  color: #71717a;
}

.today-val {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  margin-bottom: 0;
  padding: 28rpx;
}

.stat-head {
  font-size: 22rpx;
  color: #71717a;
  margin-bottom: 14rpx;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
}

.list-head {
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #d4d4d8;
}

.list-sub {
  font-size: 24rpx;
  color: #10b981;
}

.order-id {
  font-size: 22rpx;
  color: #71717a;
  font-family: monospace;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.cust-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.cust-time {
  font-size: 24rpx;
  color: #a1a1aa;
  margin-top: 8rpx;
}

.cust-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.cust-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  border: 2rpx solid #3f3f46;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
