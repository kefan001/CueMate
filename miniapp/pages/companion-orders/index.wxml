<view class="page-shell">
  <view class="page-header">
    <view class="page-title">我的接单</view>

    <scroll-view scroll-x class="tabs-scroll" show-scrollbar="{{false}}">
      <view class="tabs-row">
        <view
          wx:for="{{tabs}}"
          wx:key="*this"
          class="tab-item {{activeTab === item ? 'tab-item-active' : ''}}"
          data-tab="{{item}}"
          bindtap="onSelectTab"
        >
          <text>{{item}}</text>
          <view wx:if="{{activeTab === item}}" class="tab-indicator"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="page-body">
    <view wx:if="{{filtered.length === 0}}" class="empty-box">
      暂无相关订单
    </view>

    <view wx:for="{{filtered}}" wx:key="id" class="card">
      <view class="row-between order-top">
        <text class="order-id">{{item.id}}</text>
        <view class="status-badge tone-{{item.statusMeta.tone}}">{{item.statusMeta.label}}</view>
      </view>

      <view class="cust-name">{{item.customerName || '用户'}}</view>
      <view class="cust-time">{{item.timeText}}</view>

      <view wx:if="{{item.dispute}}" class="dispute-box">
        {{item.dispute.reason}}
      </view>

      <view wx:if="{{item.customerReview}}" class="card-inner rev-box">
        <view class="rev-title">用户给你的评价</view>
        <view class="stars-row">
          <text wx:for="{{item.customerStars}}" wx:key="*this">★</text>
        </view>
        <view wx:if="{{item.customerReview.tags && item.customerReview.tags.length}}" class="rev-tags">
          <text wx:for="{{item.customerReview.tags}}" wx:for-item="tag" wx:key="*this" class="pill pill-active">{{tag}}</text>
        </view>
        <view class="rev-text">{{item.customerReview.content}}</view>
        <view wx:if="{{item.customerReview.followUp}}" class="followup-inline">
          用户追评：{{item.customerReview.followUp.content}}
        </view>
      </view>

      <view wx:if="{{item.companionReview}}" class="card-inner rev-box rev-box-green">
        <view class="rev-title">你给用户的评价</view>
        <view class="stars-row">
          <text wx:for="{{item.companionStars}}" wx:key="*this">★</text>
        </view>
        <view wx:if="{{item.companionReview.tags && item.companionReview.tags.length}}" class="rev-tags">
          <text wx:for="{{item.companionReview.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
        </view>
        <view class="rev-text">{{item.companionReview.content}}</view>
        <view wx:if="{{item.companionReview.followUp}}" class="followup-inline">
          追评：{{item.companionReview.followUp.content}}
        </view>
      </view>

      <view class="row-between order-bottom">
        <view class="order-total">¥{{item.totalPrice}}</view>

        <view class="action-group">
          <block wx:if="{{item.status === 'paid'}}">
            <view class="btn-sm-primary" data-id="{{item.id}}" bindtap="startService">开始服务</view>
            <view class="btn-sm-danger" data-id="{{item.id}}" bindtap="onOpenNoShow">用户未到</view>
          </block>

          <block wx:if="{{item.status === 'in_progress'}}">
            <view class="btn-sm-warning" data-id="{{item.id}}" bindtap="onOpenDispute">提交申诉</view>
            <view class="btn-sm-outline" data-id="{{item.id}}" bindtap="finishService">提交完成</view>
          </block>

          <view wx:if="{{item.status === 'awaiting_confirmation'}}" class="btn-sm-outline">
            等待用户确认
          </view>

          <view
            wx:if="{{item.status === 'completed' && !item.companionReview}}"
            class="btn-sm-outline"
            data-id="{{item.id}}"
            bindtap="onOpenReview"
          >评价用户</view>

          <view
            wx:if="{{item.status === 'completed' && item.companionReview && !item.companionReview.followUp}}"
            class="btn-sm-outline"
            data-id="{{item.id}}"
            bindtap="onOpenFollowUp"
          >追加评价</view>

          <view wx:if="{{item.status === 'disputed'}}" class="btn-sm-warning">
            平台处理中
          </view>
        </view>
      </view>
    </view>
  </view>

  <bottom-nav active="companion-orders" />

  <!-- 标记用户爽约 -->
  <modal-sheet open="{{!!noShowOrder}}" title="标记用户爽约" bind:close="onCloseNoShow">
    <view wx:if="{{noShowOrder}}" class="modal-stack">
      <view class="modal-desc">确认后订单将被标记为“用户爽约”，该时段会从正常服务中移除。</view>
      <view class="btn-danger-full" bindtap="confirmNoShow">确认标记</view>
    </view>
  </modal-sheet>

  <!-- 陪玩端申诉 -->
  <modal-sheet open="{{!!disputeOrder}}" title="陪玩端申诉" bind:close="onCloseDispute">
    <view wx:if="{{disputeOrder}}" class="modal-stack">
      <textarea
        class="textarea-box"
        value="{{disputeReason}}"
        data-field="disputeReason"
        bindinput="onInputField"
      />
      <view class="btn-orange-full" bindtap="submitDispute">提交给平台</view>
    </view>
  </modal-sheet>

  <!-- 评价用户 -->
  <modal-sheet open="{{!!reviewOrder}}" title="评价本次用户" bind:close="onCloseReview">
    <view wx:if="{{reviewOrder}}" class="modal-stack">
      <view class="modal-desc">{{reviewOrder.customerName || '该用户'}} 的服务配合度如何？</view>
      <view class="star-picker">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star-pick-item {{item <= reviewRating ? 'star-pick-on' : ''}}"
          data-star="{{item}}"
          bindtap="onSetReviewRating"
        >★</text>
      </view>
      <textarea
        class="textarea-box"
        value="{{reviewContent}}"
        data-field="reviewContent"
        bindinput="onInputField"
        placeholder="写下守时、沟通、现场配合度等，方便后续匹配..."
        placeholder-style="color:#52525b;"
      />
      <view>
        <view class="rev-title" style="margin-bottom:14rpx;">快捷标签</view>
        <view class="tag-pick-wrap">
          <view
            wx:for="{{reviewTagItems}}"
            wx:key="tag"
            class="pill {{item.active ? 'pill-active' : ''}}"
            data-tag="{{item.tag}}"
            bindtap="onToggleReviewTag"
          >{{item.tag}}</view>
        </view>
      </view>
      <view class="anon-row" bindtap="onToggleAnonymous">
        <view class="anon-check {{reviewAnonymous ? 'anon-check-on' : ''}}">{{reviewAnonymous ? '✓' : ''}}</view>
        <text>匿名评价</text>
      </view>
      <view class="btn-primary" bindtap="submitReview">提交评价</view>
    </view>
  </modal-sheet>

  <!-- 追加评价 -->
  <modal-sheet open="{{!!followUpOrder}}" title="追加评价" bind:close="onCloseFollowUp">
    <view wx:if="{{followUpOrder}}" class="modal-stack">
      <view class="modal-desc">补充这位用户在后续沟通或复约上的表现。</view>
      <textarea
        class="textarea-box"
        value="{{followUpContent}}"
        data-field="followUpContent"
        bindinput="onInputField"
        placeholder="比如沟通是否持续顺畅、是否愿意继续合作..."
        placeholder-style="color:#52525b;"
      />
      <view class="btn-secondary" bindtap="submitFollowUp">提交追评</view>
    </view>
  </modal-sheet>
</view>
