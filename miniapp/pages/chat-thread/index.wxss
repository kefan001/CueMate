.not-found {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}

.nf-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.nf-desc {
  font-size: 26rpx;
  color: #71717a;
  margin-top: 12rpx;
}

.nf-btn {
  margin-top: 40rpx;
}

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #09090b;
}

.chat-top-bar {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 36rpx;
  border-bottom: 2rpx solid rgba(39, 39, 42, 0.7);
  background-color: rgba(9, 9, 11, 0.96);
}

.top-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
}

.top-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.top-status {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 4rpx;
}

.chat-scroll {
  flex: 1;
  padding: 28rpx 32rpx;
  background: radial-gradient(circle at top, #0f3a2f 0%, #09090b 38%, #09090b 100%);
  overflow-y: auto;
}

.service-card {
  border-radius: 36rpx;
  border: 2rpx solid rgba(16, 185, 129, 0.2);
  background-color: rgba(0, 0, 0, 0.35);
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
}

.sc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.sc-time {
  font-size: 24rpx;
  color: #a1a1aa;
  margin-top: 8rpx;
}

.sc-spark {
  color: #facc15;
  font-size: 32rpx;
}

.sc-venue {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #a1a1aa;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 32rpx;
}

.msg-row {
  display: flex;
}

.msg-row-sys {
  justify-content: center;
}

.msg-row-mine {
  justify-content: flex-end;
}

.msg-row-peer {
  justify-content: flex-start;
}

.sys-pill {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background-color: rgba(24, 24, 27, 0.85);
  border: 2rpx solid #27272a;
  font-size: 22rpx;
  color: #71717a;
}

.msg-bubble {
  max-width: 78%;
  border-radius: 36rpx;
  padding: 22rpx 28rpx;
}

.bubble-mine {
  background-color: #059669;
  color: #ffffff;
  border-bottom-right-radius: 12rpx;
}

.bubble-peer {
  background-color: rgba(24, 24, 27, 0.92);
  border: 2rpx solid #27272a;
  color: #f4f4f5;
  border-bottom-left-radius: 12rpx;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.msg-img {
  width: 380rpx;
  border-radius: 24rpx;
}

.img-caption {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.voice-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 260rpx;
  padding: 8rpx 0;
}

.voice-icon {
  font-size: 32rpx;
}

.voice-label {
  font-size: 26rpx;
}

.voice-dur {
  font-size: 22rpx;
  opacity: 0.75;
  margin-left: auto;
}

.msg-foot {
  font-size: 20rpx;
  margin-top: 12rpx;
  opacity: 0.72;
  gap: 20rpx;
}

.chat-input-bar {
  border-top: 2rpx solid rgba(39, 39, 42, 0.75);
  background-color: rgba(9, 9, 11, 0.96);
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
}

.quick-scroll {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.quick-row {
  display: inline-flex;
  gap: 16rpx;
}

.quick-pill {
  color: #d4d4d8;
}

.rec-hint {
  font-size: 22rpx;
  color: #fb7185;
  margin-bottom: 14rpx;
}

.input-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tool-circle {
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  border: 2rpx solid #27272a;
  background-color: #18181b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.tool-recording {
  border-color: #f43f5e;
  background-color: rgba(244, 63, 94, 0.18);
  color: #fda4af;
}

.chat-input {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  border: 2rpx solid #27272a;
  background-color: #18181b;
  padding: 0 32rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.send-circle {
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  border: 2rpx solid #27272a;
  background-color: #18181b;
  color: #52525b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.send-circle-active {
  background-color: #059669;
  border-color: #059669;
  color: #ffffff;
}
