.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.brand-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background-color: #10b981;
  box-shadow: 0 0 20rpx rgba(16, 185, 129, 0.65);
}

.loc-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #a1a1aa;
}

.loc-pin {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.loc-label {
  font-size: 22rpx;
  color: #52525b;
  margin-top: 6rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.circle-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background-color: #18181b;
  border: 2rpx solid #27272a;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d4d4d8;
  font-size: 30rpx;
}

.circle-btn-granted {
  color: #34d399;
  border-color: rgba(16, 185, 129, 0.45);
}

.list-bar {
  margin-bottom: 24rpx;
}

.list-count {
  font-size: 26rpx;
  color: #a1a1aa;
  font-weight: 500;
}

.filter-trigger {
  font-size: 24rpx;
  color: #a1a1aa;
}

.companion-row {
  display: flex;
  gap: 28rpx;
}

.avatar-wrap {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
}

.companion-avatar {
  width: 156rpx;
  height: 156rpx;
  border-radius: 24rpx;
}

.distance-badge {
  position: absolute;
  right: -8rpx;
  bottom: -10rpx;
  background-color: #059669;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 4rpx solid #09090b;
}

.companion-main {
  flex: 1;
  min-width: 0;
}

.companion-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.companion-level {
  font-size: 24rpx;
  color: #facc15;
  margin-top: 4rpx;
}

.price-box {
  text-align: right;
}

.price-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.price-unit {
  font-size: 20rpx;
  color: #71717a;
}

.rating-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
}

.star-icon {
  color: #facc15;
}

.rating-val {
  color: #ffffff;
  font-weight: 600;
}

.rating-count {
  color: #a1a1aa;
}

.tags-wrap {
  margin-top: 18rpx;
}

.modal-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #18181b;
  border: 2rpx solid #27272a;
  border-radius: 28rpx;
  padding: 20rpx 28rpx;
}

.search-input {
  flex: 1;
  color: #ffffff;
  font-size: 28rpx;
}

.clear-btn {
  color: #71717a;
  font-size: 26rpx;
  padding: 4rpx 8rpx;
}

.filter-meta {
  font-size: 24rpx;
}

.reset-link {
  color: #a1a1aa;
}

.pill-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
}

.filter-val {
  font-size: 28rpx;
  color: #d4d4d8;
}

.filter-tip {
  font-size: 20rpx;
  color: #71717a;
}

.sort-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.sort-btn {
  justify-content: center;
  padding: 22rpx 0;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.action-half {
  flex: 1;
}
