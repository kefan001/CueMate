<view wx:if="{{companion}}" class="detail-page">
  <view class="hero-wrap">
    <image class="hero-img" src="{{companion.images[0] || companion.avatar}}" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="hero-bottom row-between">
      <view>
        <view class="hero-name">{{companion.name}}</view>
        <view class="hero-level row-center">
          <ui-icon name="check-circle" size="28" color="#facc15" />
          <text style="margin-left: 8rpx;">{{companion.level}}</text>
        </view>
      </view>
      <image class="hero-avatar" src="{{companion.avatar}}" mode="aspectFill" />
    </view>
  </view>

  <view class="detail-content">
    <view class="stats-bar">
      <view class="stat-col">
        <view class="stat-val row-center" style="justify-content:center;">
          <ui-icon name="star-fill" size="28" color="#facc15" />
          <text style="margin-left: 8rpx;">{{reviewSummary.count > 0 ? reviewSummary.average : companion.rating}}</text>
        </view>
        <view class="stat-label">{{reviewSummary.count > 0 ? reviewSummary.count : companion.reviewCount}} 条评价</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-col">
        <view class="stat-val">¥{{companion.hourlyRate}}</view>
        <view class="stat-label">每小时</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-col">
        <view class="stat-val row-center" style="justify-content:center;">
          <ui-icon name="map-pin" size="28" color="#a1a1aa" />
          <text style="margin-left: 6rpx;">{{companion.distance}}</text>
        </view>
        <view class="stat-label">距离</view>
      </view>
    </view>

    <view class="section-block">
      <view class="section-title">关于我</view>
      <view class="bio-text">{{companion.bio}}</view>
      <view class="tags-row">
        <text wx:for="{{companion.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>

      <view
        class="card-inner row-between"
        style="margin-top: 24rpx; padding: 24rpx;"
        bindtap="onOpenVenueMap"
      >
        <view class="row-center" style="gap: 12rpx;">
          <ui-icon name="map-pin" size="30" color="#10b981" />
          <view>
            <view style="font-size: 26rpx; color: #f4f4f5; font-weight: 600;">
              {{companion.venueName || 'CueMate 台球俱乐部（望京店）'}}
            </view>
            <view style="font-size: 22rpx; color: #71717a; margin-top: 4rpx;">
              {{companion.venueAddress || '北京市朝阳区望京SOHO 3号楼 B1层'}} · 点击导航
            </view>
          </view>
        </view>
        <ui-icon name="chevron-right" size="30" color="#71717a" />
      </view>
    </view>

    <view class="section-block">
      <view class="row-between section-head">
        <text class="section-title" style="margin-bottom:0;">用户评价</text>
        <text class="section-sub">{{reviewSummary.count > 0 ? '近 ' + reviewSummary.count + ' 条真实订单评价' : '当前展示历史口碑'}}</text>
      </view>

      <view wx:if="{{reviewSummary.count > 0}}" class="card-inner summary-box">
        <view class="summary-top">
          <view>
            <view class="summary-avg">{{reviewSummary.average}}</view>
            <view class="summary-rate">好评率 {{reviewSummary.positiveRate}}%</view>
          </view>
          <view class="dist-list">
            <view wx:for="{{reviewSummary.distribution}}" wx:key="star" class="dist-row">
              <text class="dist-star">{{item.star}}星</text>
              <view class="dist-track">
                <view class="dist-fill" style="width: {{item.percent}}%;"></view>
              </view>
              <text class="dist-count">{{item.count}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{reviewSummary.topTags.length}}" class="summary-tags">
          <text
            wx:for="{{reviewSummary.topTags}}"
            wx:key="tag"
            class="pill pill-active"
          >{{item.tag}} {{item.count}}</text>
        </view>
      </view>

      <view class="filter-pills">
        <view
          class="pill {{reviewFilter === 'all' ? 'pill-active' : ''}}"
          data-filter="all"
          bindtap="onSelectReviewFilter"
        >全部</view>
        <view
          class="pill {{reviewFilter === 'latest' ? 'pill-active' : ''}}"
          data-filter="latest"
          bindtap="onSelectReviewFilter"
        >最新</view>
        <view
          class="pill {{reviewFilter === 'positive' ? 'pill-active' : ''}}"
          data-filter="positive"
          bindtap="onSelectReviewFilter"
        >好评</view>
        <view
          class="pill {{reviewFilter === 'critical' ? 'pill-active' : ''}}"
          data-filter="critical"
          bindtap="onSelectReviewFilter"
        >待改进</view>
      </view>

      <view wx:if="{{visibleReviews.length === 0}}" class="card-inner empty-review">
        当前筛选下暂无评价内容。
      </view>
      <view wx:else class="review-list">
        <view wx:for="{{visibleReviews}}" wx:key="orderId" class="card-inner review-card">
          <view class="row-between">
            <text class="review-author">{{item.displayAuthorName}}</text>
            <view class="review-stars row-center" style="gap: 4rpx;">
              <ui-icon wx:for="{{item.stars}}" wx:key="*this" name="star-fill" size="24" color="#facc15" />
            </view>
          </view>
          <view class="review-date">{{item.dateText}}</view>
          <view wx:if="{{item.tags && item.tags.length}}" class="review-tags">
            <text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text>
          </view>
          <view class="review-content">{{item.content}}</view>
          <view wx:if="{{item.followUp}}" class="followup-box">
            <view class="followup-label">追评</view>
            <view class="followup-text">{{item.followUp.content}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-block">
      <view class="row-between section-head">
        <view class="row-center">
          <ui-icon name="calendar" size="34" color="#10b981" />
          <text class="section-title" style="margin-bottom:0; margin-left: 12rpx;">预约时间</text>
        </view>
        <view class="row-center section-sub">
          <ui-icon name="info" size="24" color="#71717a" />
          <text style="margin-left: 6rpx;">已锁定时段不可重复预约</text>
        </view>
      </view>

      <scroll-view scroll-x class="date-scroll" show-scrollbar="{{false}}">
        <view class="date-row">
          <view
            wx:for="{{dates}}"
            wx:key="fullDateStr"
            class="date-card {{selectedDate === index ? 'date-card-active' : ''}}"
            data-index="{{index}}"
            bindtap="onSelectDate"
          >
            <text class="date-day">{{item.dayStr}}</text>
            <text class="date-num">{{item.dateStr}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="slot-grid">
        <view
          wx:for="{{currentDaySlots}}"
          wx:key="time"
          class="slot-item {{!item.available ? 'slot-disabled' : item.selected ? 'slot-selected' : ''}}"
          data-time="{{item.time}}"
          data-available="{{item.available}}"
          bindtap="onToggleSlot"
        >
          <view>{{item.time}}</view>
          <view wx:if="{{!item.available}}" class="slot-full">{{item.lockLabel || '已满'}}</view>
        </view>
      </view>

      <view style="margin-top: 24rpx;">
        <input
          class="input-box"
          value="{{bookingNote}}"
          bindinput="onNoteInput"
          placeholder="预约备注：如想重点练习中式八球走位、自带球杆等..."
          placeholder-style="color:#52525b;"
        />
      </view>

      <view class="card-inner row-center" style="margin-top: 20rpx; padding: 18rpx 22rpx; gap: 10rpx;">
        <ui-icon name="shield-check" size="26" color="#10b981" />
        <text style="font-size: 22rpx; color: #a1a1aa;">正规绿色台球教学与陪练 · 平台担保结算 · 严禁涉赌与违规场外交易</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar row-between">
    <view>
      <view class="bar-hint">{{selectedSlots.length > 0 ? '已选 ' + selectedSlots.length + ' 小时' : '请选择时间'}}</view>
      <view class="bar-price">
        <text class="bar-currency">¥</text>
        <text>{{totalPrice}}</text>
      </view>
    </view>

    <view class="bar-actions">
      <view class="chat-circle" bindtap="handleOpenChat">
        <ui-icon name="message-circle" size="38" color="#e4e4e7" />
      </view>
      <view
        class="book-btn {{selectedSlots.length === 0 ? 'book-btn-disabled' : ''}}"
        bindtap="handleBook"
      >
        {{isBooking ? '预约中...' : '立即预约'}}
      </view>
    </view>
  </view>
</view>
