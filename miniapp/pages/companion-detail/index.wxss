.detail-page {
  min-height: 100vh;
  background-color: #09090b;
  padding-bottom: 200rpx;
}

.hero-wrap {
  position: relative;
  height: 520rpx;
  width: 100%;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(to top, #09090b 0%, rgba(9, 9, 11, 0.4) 55%, transparent 100%);
}

.hero-bottom {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 32rpx;
}

.hero-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-level {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #facc15;
  font-weight: 600;
}

.hero-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  border: 4rpx solid #27272a;
}

.detail-content {
  padding: 0 40rpx;
}

.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 2rpx solid rgba(39, 39, 42, 0.65);
}

.stat-col {
  flex: 1;
  text-align: center;
}

.stat-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-label {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: rgba(39, 39, 42, 0.7);
}

.section-block {
  margin-top: 48rpx;
}

.section-head {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.section-sub {
  font-size: 22rpx;
  color: #71717a;
}

.bio-text {
  font-size: 26rpx;
  color: #a1a1aa;
  line-height: 1.7;
}

.tags-row {
  margin-top: 24rpx;
}

.summary-box {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.summary-top {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
}

.summary-avg {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
}

.summary-rate {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.dist-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.dist-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dist-star {
  width: 52rpx;
  font-size: 20rpx;
  color: #71717a;
}

.dist-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background-color: #27272a;
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  background-color: #facc15;
  border-radius: 999rpx;
}

.dist-count {
  width: 40rpx;
  text-align: right;
  font-size: 20rpx;
  color: #71717a;
}

.summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.filter-pills {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.empty-review {
  color: #71717a;
  font-size: 26rpx;
  padding: 32rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-card {
  padding: 28rpx;
}

.review-author {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.review-stars {
  color: #facc15;
  font-size: 24rpx;
}

.review-date {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.review-tags {
  margin-top: 16rpx;
}

.review-content {
  font-size: 26rpx;
  color: #d4d4d8;
  margin-top: 16rpx;
  line-height: 1.6;
}

.followup-box {
  margin-top: 20rpx;
  background-color: rgba(9, 9, 11, 0.85);
  border: 2rpx solid #27272a;
  border-radius: 20rpx;
  padding: 20rpx;
}

.followup-label {
  font-size: 20rpx;
  color: #71717a;
}

.followup-text {
  font-size: 24rpx;
  color: #a1a1aa;
  margin-top: 6rpx;
}

.date-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.date-row {
  display: inline-flex;
  gap: 18rpx;
}

.date-card {
  width: 124rpx;
  padding: 22rpx 0;
  border-radius: 28rpx;
  border: 2rpx solid #27272a;
  background-color: #18181b;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a1a1aa;
}

.date-card-active {
  background-color: #059669;
  border-color: #10b981;
  color: #ffffff;
}

.date-day {
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.date-num {
  font-size: 26rpx;
  font-weight: 700;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.slot-item {
  padding: 24rpx 0;
  border-radius: 24rpx;
  border: 2rpx solid #27272a;
  background-color: #18181b;
  color: #d4d4d8;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.slot-selected {
  background-color: rgba(16, 185, 129, 0.2);
  border-color: #10b981;
  color: #34d399;
}

.slot-disabled {
  background-color: rgba(24, 24, 27, 0.45);
  border-color: rgba(39, 39, 42, 0.4);
  color: #52525b;
}

.slot-full {
  font-size: 20rpx;
  margin-top: 4rpx;
  opacity: 0.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #09090b;
  border-top: 2rpx solid rgba(39, 39, 42, 0.75);
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 30;
}

.bar-hint {
  font-size: 22rpx;
  color: #a1a1aa;
}

.bar-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}

.bar-currency {
  font-size: 26rpx;
  font-weight: 400;
  color: #a1a1aa;
  margin-right: 4rpx;
}

.bar-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.chat-circle {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  border: 2rpx solid #27272a;
  background-color: #18181b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.book-btn {
  padding: 26rpx 56rpx;
  border-radius: 999rpx;
  background-color: #059669;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.book-btn-disabled {
  background-color: #27272a;
  color: #71717a;
}
