.order-top {
  padding-bottom: 22rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(39, 39, 42, 0.65);
}

.order-id {
  font-size: 22rpx;
  color: #71717a;
  font-family: monospace;
}

.status-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.order-main {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.order-avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.order-time {
  font-size: 26rpx;
  color: #a1a1aa;
  margin-top: 6rpx;
}

.order-hours,
.order-venue {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.notice-box {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #a1a1aa;
}

.dispute-box {
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background-color: rgba(251, 146, 60, 0.12);
  border: 2rpx solid rgba(251, 146, 60, 0.25);
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  color: #fed7aa;
}

.review-preview {
  margin-bottom: 20rpx;
}

.stars-row {
  color: #facc15;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.review-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.review-text {
  font-size: 24rpx;
  color: #a1a1aa;
}

.followup-inline {
  margin-top: 14rpx;
  background-color: rgba(24, 24, 27, 0.9);
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #a1a1aa;
}

.order-bottom {
  padding-top: 22rpx;
  border-top: 2rpx solid rgba(39, 39, 42, 0.65);
  align-items: flex-end;
  gap: 16rpx;
}

.order-total {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

.total-label {
  font-size: 24rpx;
  font-weight: 400;
  color: #a1a1aa;
}

.action-group {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 14rpx;
}

.modal-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pay-name {
  font-size: 28rpx;
  color: #d4d4d8;
}

.pay-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.pay-time {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 10rpx;
}

.balance-row {
  font-size: 28rpx;
}

.balance-val {
  color: #ffffff;
  font-weight: 600;
}

.pay-error {
  font-size: 24rpx;
  color: #f87171;
}

.pay-hint {
  font-size: 22rpx;
  color: #71717a;
}

.modal-desc {
  font-size: 26rpx;
  color: #d4d4d8;
}

.modal-btn-row {
  display: flex;
  gap: 20rpx;
}

.half {
  flex: 1;
}

.btn-danger-full {
  background-color: #ef4444;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 36rpx;
  border-radius: 28rpx;
  text-align: center;
}

.btn-orange-full {
  background-color: #f97316;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 36rpx;
  border-radius: 28rpx;
  text-align: center;
}

.code-box {
  padding: 40rpx;
  text-align: center;
}

.code-digits {
  font-size: 64rpx;
  font-family: monospace;
  letter-spacing: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

.code-sub {
  font-size: 20rpx;
  color: #71717a;
  margin-top: 16rpx;
}

.star-picker {
  display: flex;
  gap: 16rpx;
}

.star-pick-item {
  font-size: 48rpx;
  color: #3f3f46;
}

.star-pick-on {
  color: #facc15;
}

.tag-pick-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.anon-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #a1a1aa;
}

.anon-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #52525b;
  background-color: #18181b;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #10b981;
  font-size: 24rpx;
}

.anon-check-on {
  border-color: #10b981;
}
