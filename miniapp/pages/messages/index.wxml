<view class="page-shell">
  <view class="page-header">
    <view class="row-between">
      <view>
        <view class="page-title">聊天消息</view>
        <view class="page-subtitle">
          {{user.role === 'user' ? '预约前先沟通打法和时间细节' : '及时回复用户，提升成单与服务体验'}}
        </view>
        <view class="conn-hint">
          {{connectionState === 'connected' ? 'WebSocket 实时在线' : '演示实时模式（智能自动回复）'}}
        </view>
      </view>
      <view class="msg-badge-icon">💬</view>
    </view>
  </view>

  <view class="page-body">
    <view wx:if="{{threadCards.length === 0}}" class="empty-chat">
      <view class="empty-circle">💬</view>
      <view class="empty-title">还没有聊天会话</view>
      <view class="empty-desc">从陪玩详情页点击“先聊聊”后，消息会出现在这里。</view>
    </view>

    <view
      wx:for="{{threadCards}}"
      wx:key="id"
      class="card thread-card"
      data-id="{{item.id}}"
      bindtap="onTapThread"
    >
      <view class="thread-row">
        <view class="peer-avatar-wrap">
          <image class="peer-avatar" src="{{item.peerAvatar}}" mode="aspectFill" />
          <view wx:if="{{item.unread > 0}}" class="unread-badge">{{item.unreadText}}</view>
        </view>

        <view class="thread-main">
          <view class="row-between">
            <view>
              <view class="peer-name">{{item.peerName}}</view>
              <view class="msg-time">{{item.timeText}}</view>
            </view>
            <text class="arrow-right">›</text>
          </view>

          <view class="msg-preview">{{item.preview}}</view>

          <view wx:if="{{item.scheduleLabel}}" class="schedule-pill">
            <text class="schedule-icon">🕒</text>
            <text class="schedule-text">{{item.scheduleLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <bottom-nav active="messages" />
</view>
